{
  "name": "resolveai",
  "main": "./worker.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "previews": {},
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resolveai-db",
      "database_id": "54692786-75fb-40df-83b8-c3651dcdd996"
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}

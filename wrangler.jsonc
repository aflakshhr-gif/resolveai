{
  "name": "resolveai",
  "main": "./worker.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "previews": {},
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}

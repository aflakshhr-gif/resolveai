{
  "name": "resolveai",
  "main": "./worker.js",
  "compatibility_date": "2026-11-02",
  "workers_dev": true,
  "previews": {
    "vars": {
      "RESOLVEAI_PUBLIC_URL": "https://feature-unit-membership-approval-resolveai.aflakshhr.workers.dev"
    },
    "send_email": [
      {
        "name": "EMAIL",
        "remote": true
      }
    ],
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "resolveai-preview-db",
        "database_id": "faf1fd5e-2bc7-462d-9a23-2d2ac3ecefc8"
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "resolveai-db",
      "database_id": "54692786-75fb-40df-83b8-c3651dcdd996"
    }
  ],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true,
    "issues": {
      "enabled": true
    }
  }
}

{
  "expo": {
    "name": "ResolveAI",
    "slug": "resolveai-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "resolveai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#f7f8fc"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2",
      "bundleIdentifier": "com.resolveai.support"
    },
    "android": {
      "package": "com.resolveai.support",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#635bff"
      }
    },
    "plugins": ["expo-secure-store"],
    "extra": {
      "websiteUrl": "https://resolveai.aflakshhr.workers.dev"
    }
  }
}
